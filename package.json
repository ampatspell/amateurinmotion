{
  "name": "amateurinmotion",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "flc": "npm run format && npm run check && npm run lint",
    "start": "tiny migrate-to-latest && node build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "6.0.0-next.12",
    "@sveltejs/kit": "^3.0.0-next.29",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.1",
    "sass-embedded": "^1.105.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@ampatspell/tiny": "^0.17.1",
    "better-sqlite3": "^12.11.1",
    "kysely": "^0.29.6",
    "valibot": "^1.5.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true
  }
}
